# ---------------------------------------------------------------------------
# For Samee, My Love — environment
# Copy to .env.local for development, add the same keys in Vercel for production.
# ---------------------------------------------------------------------------

# Hosted Postgres (Supabase → Project Settings → Database → Connection string).
# Use the pooled connection string, port 6543, for serverless. Leave empty to
# run against an embedded local Postgres (PGlite) during development.
DATABASE_URL=
# Set to "false" only for a local Postgres without TLS.
DATABASE_SSL=false

# The birthday lock answer. Never shipped to the browser.
BIRTHDAY_LOCK_PASSWORD=14112007

# Signs the admin session cookie. Use 32+ random characters in production:
#   openssl rand -base64 48
SESSION_SECRET=

# The owner's dashboard login. Stored server-side as a bcrypt hash on first use.
ADMIN_USERNAME=samee_mine
ADMIN_PASSWORD=samee_my_love

# Only for local demos: lets the app run with the example credentials above.
ALLOW_DEMO_LOCK=true
