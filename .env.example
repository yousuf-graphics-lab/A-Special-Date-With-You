# ---------------------------------------------------------------------------
# For Samee, My Love — environment
#
# Local development: copy to .env.local. The app then runs on an embedded
# PostgreSQL (PGlite) with the example credentials below — nothing else needed.
#
# Production (Vercel): every value marked REQUIRED must be set as an
# environment variable. Missing secrets disable the feature loudly instead of
# falling back to a guessable default.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string → URI (pooled,
# port 6543). REQUIRED in production: serverless filesystems are ephemeral.
DATABASE_URL=

# "false" only for a local Postgres without TLS.
DATABASE_SSL=true

# The birthday lock answer. Checked on the server, never shipped to the browser.
# REQUIRED in production (otherwise the lock is disabled).
BIRTHDAY_LOCK_PASSWORD=14112007

# Signs the admin session cookie; 32+ characters.
# Generate with: openssl rand -base64 48
# REQUIRED in production (otherwise dashboard login refuses to run).
SESSION_SECRET=

# The owner's dashboard login. Stored server-side as a bcrypt hash.
# REQUIRED in production.
ADMIN_USERNAME=samee_mine
ADMIN_PASSWORD=samee_my_love

# Where the local embedded database keeps its files (ignored by git).
# PGLITE_DIR=.data/pglite

# Only for smoke-testing a production build on your own machine
# (`npm run build && ALLOW_EMBEDDED_DATABASE=true npm run start`).
# Never set this on a server: the embedded database lives on local disk.
# ALLOW_EMBEDDED_DATABASE=true
